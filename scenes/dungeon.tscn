[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/core/dungeon.gd" id="1_dungeon"]
[ext_resource type="Script" path="res://scripts/core/iso_grid.gd" id="2_grid"]
[ext_resource type="Script" path="res://scripts/ui/cell_highlighter.gd" id="3_highlighter"]
[ext_resource type="Script" path="res://scripts/core/dungeon_controller.gd" id="4_controller"]
[ext_resource type="Script" path="res://scripts/ui/camera_controller.gd" id="5_camera"]
[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="6_hud"]

[node name="Dungeon" type="Node2D"]
script = ExtResource("1_dungeon")

[node name="IsoGrid" type="Node" parent="."]
script = ExtResource("2_grid")

[node name="Floor" type="TileMapLayer" parent="."]

[node name="Highlights" type="Node2D" parent="."]
script = ExtResource("3_highlighter")

[node name="World" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Walls" type="TileMapLayer" parent="World"]
y_sort_enabled = true

[node name="Controller" type="Node2D" parent="."]
script = ExtResource("4_controller")

[node name="Camera2D" type="Camera2D" parent="."]
script = ExtResource("5_camera")

[node name="Hud" type="CanvasLayer" parent="."]
script = ExtResource("6_hud")
